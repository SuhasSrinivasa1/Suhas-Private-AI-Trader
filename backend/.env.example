APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000

# Trading safety defaults
TRADING_PROFILE_ENABLED=true
GROWW_LIVE_EXECUTION_ENABLED=false
MAX_RISK_PER_TRADE_PCT=1.0
MIN_REWARD_RISK_RATIO=2.0
MAX_CHASE_PCT=1.5
MAX_PRICE_AGE_SECONDS=120
MIN_CONFIRMATION_SOURCES=2
MAX_POSITION_VALUE_PCT=20
MIN_BUY_CONFIDENCE=72
MIN_WATCH_CONFIDENCE=58
MAX_SPREAD_PCT=0.35
MAX_INTRADAY_RANGE_PCT=7.0

# Fallback REST scanner and deep revalidation
SCAN_INTERVAL_SECONDS=15
DEEP_SCAN_CANDIDATES=10
MAX_DISPLAY_OPPORTUNITIES=8
SIGNAL_VALID_SECONDS=20
DEFAULT_PORTFOLIO_VALUE=20000
STARTING_CAPITAL_INR=20000
STRETCH_TARGET_INR=100000
TARGET_HORIZON_DAYS=30

# Full NSE cash-equity universe. The official Groww instrument master is cached locally.
SCANNER_UNIVERSE_MODE=full_nse_equity
BROAD_SCAN_BATCH_SIZE=250

# Production 2.0 event-driven engine
ENABLE_GROWW_FEED=true
ENABLE_AUTO_LLM=true
ENABLE_SEMANTIC_MEMORY=true
NEWS_PRIORITY_INTERVAL_SECONDS=15
NEWS_BROAD_INTERVAL_SECONDS=60
MATERIAL_PRICE_MOVE_PCT=0.12
MATERIAL_RESCAN_COOLDOWN_SECONDS=3
PRICE_PERSIST_INTERVAL_SECONDS=5
BROWSER_TICK_MIN_INTERVAL_SECONDS=0.25
OUTCOME_HORIZONS_MINUTES=15,30,60

# Six-month historical pattern agent and automatic daily engine
PATTERN_CACHE_TTL_SECONDS=21600
NEWS_CACHE_TTL_SECONDS=1200
DAILY_TOP_COUNT=10
DAILY_NEWS_CANDIDATES=18
FREE_NEWS_LOOKBACK=3d
FREE_NEWS_MAX_RECORDS=20
FREE_NEWS_ENABLED=true
NEWS_REQUIRED_FOR_BUY=true

# Local AI. bootstrap.sh updates OLLAMA_MODEL based on Mac memory.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional override. Default is macOS Application Support in production.
TRADER_DB_PATH=
PRICE_RETENTION_DAYS=30
NEWS_RETENTION_DAYS=365
LLM_RETENTION_DAYS=180

# Production Mac secret source. Groww API key and secret should be stored in macOS Keychain.
GROWW_CREDENTIAL_SOURCE=keychain

# Environment-variable fallback exists only for CI or advanced manual use.
# Never commit real credentials. Leave these blank in the project.
GROWW_API_KEY=
GROWW_API_SECRET=

# Optional: override full-NSE discovery with your own comma-separated symbols.
# SCANNER_UNIVERSE=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY

# Production 2.2 trading mode and mandatory technical agents
DEFAULT_TRADING_MODE=intraday
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9
RSI_PERIOD=14

# Production 2.3 Calls & Results paper-evaluation layer
PAPER_OBSERVATION_DAYS=7
CALL_RESOLUTION_INTERVAL_SECONDS=15
INTRADAY_CALL_DEDUP_MINUTES=30
DELIVERY_CALL_DEDUP_MINUTES=1440
DELIVERY_CALL_HORIZON_DAYS=7
CALL_TARGET_PRECISION=0.99
CALL_MIN_CALIBRATION_SAMPLES=50
CALL_CONFIDENCE_MIN=72
CALL_CONFIDENCE_MAX=95

# Production 2.4.1 always-on duty. Live scanning remains session-bound; off-hours research uses Groww last-known/history/news only.
OFF_HOURS_RESEARCH_INTERVAL_SECONDS=900
OFF_HOURS_LLM_INTERVAL_SECONDS=1800
OFF_HOURS_CANDIDATE_VALID_SECONDS=21600
OFF_HOURS_DEEP_CANDIDATES=8
