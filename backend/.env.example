APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Trading safety defaults
TRADING_PROFILE_ENABLED=true
GROWW_LIVE_EXECUTION_ENABLED=false
MAX_RISK_PER_TRADE_PCT=1.0
MIN_REWARD_RISK_RATIO=2.0
MAX_CHASE_PCT=1.5
MAX_PRICE_AGE_SECONDS=120
MIN_CONFIRMATION_SOURCES=2
MAX_POSITION_VALUE_PCT=20
MIN_BUY_CONFIDENCE=72
MIN_WATCH_CONFIDENCE=58
MAX_SPREAD_PCT=0.35
MAX_INTRADAY_RANGE_PCT=7.0

# Agentic intraday scanner
SCAN_INTERVAL_SECONDS=15
DEEP_SCAN_CANDIDATES=10
MAX_DISPLAY_OPPORTUNITIES=8
SIGNAL_VALID_SECONDS=20
DEFAULT_PORTFOLIO_VALUE=500000

# Optional: replace the default liquid NSE universe with your own comma-separated symbols.
# SCANNER_UNIVERSE=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY

# Groww credentials are intentionally blank. Add them only to backend/.env on your Mac.
# Never commit passwords, OTPs, PINs, TOTP seeds, recovery codes, or broker secrets.
GROWW_API_KEY=
GROWW_API_SECRET=

# See LOCAL_ENV_SETUP.md. backend/.env is ignored by Git.
