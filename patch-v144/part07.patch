+package com.suhas.multyfideliverybuy;
+
+import android.app.AlarmManager;
+import android.app.PendingIntent;
+import android.content.Context;
+import android.content.Intent;
+
+import java.util.Calendar;
+import java.util.TimeZone;
+
+final class AutoAuthScheduler {
+    static final String ACTION_DAILY = "com.suhas.multyfideliverybuy.AUTO_AUTH_DAILY";
+    static final String ACTION_RETRY = "com.suhas.multyfideliverybuy.AUTO_AUTH_RETRY";
+    static final int DAILY_HOUR_IST = 8;
+    static final int DAILY_MINUTE_IST = 45;
+    private static final long RETRY_DELAY_MS = 5L * 60L * 1000L;
+    private static final int DAILY_REQUEST = 1441;
+    private static final int RETRY_REQUEST = 1442;
+
+    private AutoAuthScheduler() {}
+
+    static void scheduleNextDaily(Context context) {
+        AlarmManager alarm = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+        if (alarm == null) return;
+        long trigger = nextDailyMillis(System.currentTimeMillis());
+        alarm.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, trigger,
+                pending(context, ACTION_DAILY, DAILY_REQUEST));
+    }
+
+    static void scheduleRetry(Context context) {
+        AlarmManager alarm = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+        if (alarm == null) return;
+        alarm.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP,
+                System.currentTimeMillis() + RETRY_DELAY_MS,
+                pending(context, ACTION_RETRY, RETRY_REQUEST));
+    }
+
+    static void cancelRetry(Context context) {
+        AlarmManager alarm = (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+        if (alarm != null) alarm.cancel(pending(context, ACTION_RETRY, RETRY_REQUEST));
+    }
+
+    static long nextDailyMillis(long now) {
+        Calendar cal = Calendar.getInstance(TimeZone.getTimeZone("Asia/Kolkata"));
+        cal.setTimeInMillis(now);
+        cal.set(Calendar.HOUR_OF_DAY, DAILY_HOUR_IST);
+        cal.set(Calendar.MINUTE, DAILY_MINUTE_IST);
+        cal.set(Calendar.SECOND, 0);
+        cal.set(Calendar.MILLISECOND, 0);
+        if (cal.getTimeInMillis() <= now) cal.add(Calendar.DAY_OF_MONTH, 1);
+        return cal.getTimeInMillis();
+    }
+
+    private static PendingIntent pending(Context context, String action, int requestCode) {
+        Intent intent = new Intent(context, AutoAuthReceiver.class).setAction(action);
+        return PendingIntent.getBroadcast(context, requestCode, intent,
+                PendingIntent.FLAG_UPDATE_CURRENT | PendingIntent.FLAG_IMMUTABLE);
+    }
+}
