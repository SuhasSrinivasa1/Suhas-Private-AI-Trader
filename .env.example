APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

TRADING_PROFILE_ENABLED=true
ALLOW_LIVE_EXECUTION=false
MAX_RISK_PER_TRADE_PCT=1.0
MIN_REWARD_RISK_RATIO=2.0
MAX_CHASE_PCT=1.5
MAX_PRICE_AGE_SECONDS=120
MIN_CONFIRMATION_SOURCES=2

# Broker credentials must never be committed.
# Add future provider variables only to your local .env or a secret manager.

# Production 2.2 trading mode and mandatory technical agents
DEFAULT_TRADING_MODE=intraday
MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9
RSI_PERIOD=14
